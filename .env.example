# Copy to .env for local overrides (never commit .env)

# Flask session secret — change for any shared or production deployment
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# REQUIRED: PostgreSQL is the primary centralized database
DATABASE_URL=postgresql://user:password@localhost:5432/bsciams

# Force PostgreSQL even outside Render (recommended)
REQUIRE_POSTGRES=true

# Local offline trials ONLY (do not use for the instructor/demo deployment)
# ALLOW_SQLITE=1

# Set automatically on Render; enables Secure session cookies
# RENDER=true

# Local server port (default 5000)
# PORT=5000
